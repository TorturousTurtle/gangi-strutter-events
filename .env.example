# Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# DATABASE
# =============================================================================
DB_HOST=localhost
DB_NAME=competition_events
DB_USER=app_user
DB_PASS=
DB_CHARSET=utf8mb4

# =============================================================================
# ADMIN AUTHENTICATION
# =============================================================================
ADMIN_USER=admin
# DEPRECATED: Use ADMIN_PASS_HASH instead (bcrypt hash)
ADMIN_PASS=
# Bcrypt hash of admin password. Generate with: php server/hash-password.php
# Example: ADMIN_PASS_HASH=$2y$12$...
ADMIN_PASS_HASH=

# =============================================================================
# ENCRYPTION
# =============================================================================
# 32-byte key (64 hex characters) for AES-256-GCM encryption of payment credentials
# Generate with: php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=

# =============================================================================
# STRIPE PAYMENT PROCESSING (Legacy - now managed via Admin Settings)
# =============================================================================
# These can still be set here for backward compatibility,
# but the recommended approach is to configure via Admin > Settings tab.
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=production
APP_URL=https://example.com
APP_DEBUG=false

# =============================================================================
# EMAIL (future use)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
